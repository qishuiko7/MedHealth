# =============================================================================
# MedHealth 环境变量模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env        ——  cp .env.example .env
#   2. 按本机实际情况修改 .env 中的值
#   3. 加载环境变量后运行程序：
#        Windows PowerShell:  Get-Content .env | ForEach-Object { ... }
#        Linux/macOS:         set -a && source .env && set +a
#
# 重要：
#   - .env 已被 .gitignore 排除，**不会被提交**，可安全填写真实口令
#   - 本文件（.env.example）只含占位值，可以公开
#   - 所有变量都有代码内默认值，不配置也能跑（使用演示默认值）
# =============================================================================


# -----------------------------------------------------------------------------
# MySQL 数据库连接
# -----------------------------------------------------------------------------
# 数据库主机地址，本机填 127.0.0.1
MED_MYSQL_HOST=127.0.0.1

# 数据库端口，MySQL 默认 3306
MED_MYSQL_PORT=3306

# 数据库用户名
MED_MYSQL_USER=root

# 数据库口令 —— 改成你自己的
MED_MYSQL_PASSWORD=your_password_here

# 业务数据库名，与 database/med_health_数据备份.sql 中的库名保持一致
MED_MYSQL_DATABASE=med_health


# -----------------------------------------------------------------------------
# Flask Web 平台
# -----------------------------------------------------------------------------
# 监听地址，127.0.0.1 表示仅本机可访问；要局域网访问改成 0.0.0.0
MED_WEB_HOST=127.0.0.1

# 监听端口，默认 5000
MED_WEB_PORT=5000

# Flask 会话密钥 —— 请改成一段随机字符串
# 生成方法： python -c "import secrets; print(secrets.token_hex(32))"
MED_WEB_SECRET_KEY=change_this_to_a_random_string


# -----------------------------------------------------------------------------
# 平台演示账号口令
# -----------------------------------------------------------------------------
# 三个角色的登录口令，默认值与代码内一致
# 角色说明：admin 管理员（全部权限）/ doctor 医师（不可导出敏感明细）/ viewer 访客（只读）
# 注意：以下为课程演示用弱口令，实际部署请务必修改
MED_ADMIN_PWD=admin123
MED_DOCTOR_PWD=doctor123
MED_VIEWER_PWD=viewer123


# -----------------------------------------------------------------------------
# 大数据集群（仅部署集群时需要，单机运行可忽略）
# -----------------------------------------------------------------------------
# 以下变量用于 deploy/ 下的集群部署脚本，单机复现无需配置
#
# HIVE_META_PWD=change-me-hive
# MYSQL_ROOT_PWD=change-me-root
# BIZ_PWD=change-me-biz
